PORT=
DATABASE_URL=postgresql://cardtable:cardtable@localhost:5432/cardtable?schema=public
REDIS_URL=redis://localhost:6379
AUTH_SECRET=replace-with-a-long-random-secret
SESSION_TTL_DAYS=30
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
